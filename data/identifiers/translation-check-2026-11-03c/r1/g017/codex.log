from concurrent.futures import ThreadPoolExecutor
urls=['https://catalog.princeton.edu/catalog.json?q=Meninas+perdidas&search_field=all_fields','https://searchworks.stanford.edu/catalog.json?q=%22Meninas+perdidas%22','https://catalog.princeton.edu/catalog.json?q=Escravo+ou+campones&search_field=all_fields','https://catalog.loc.gov/vwebv/search?searchArg=Meninas+perdidas&searchCode=TALL&searchType=1&recCount=25']
def f(url):
 try:
  r=requests.get(url,timeout=15)
  if r.status_code==200:
   from bs4 import BeautifulSoup
   txt=BeautifulSoup(r.text,'html.parser').get_text(' ',strip=True) if '<html' in r.text[:500] else r.text
   return url+' STATUS '+str(r.status_code)+' '+txt[:18000]
  return url+' STATUS '+str(r.status_code)
 except Exception as e:return url+' '+str(e)
with ThreadPoolExecutor(max_workers=4) as p:
 for x in p.map(f,urls):print(x)
