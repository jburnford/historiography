import requests,json
from concurrent.futures import ThreadPoolExecutor
queries=['Postmodernism cultural logic late capitalism Jameson','Ökonomisch-philosophische Manuskripte Marx 2005','Fontes históricas','Arte moderna Argan 1970','Nations nationalism since 1780 Hobsbawm','O P.C.B. Carone 1982']
def f(q):
 try:
  j=requests.get('https://catalog.princeton.edu/catalog.json',params={'q':q,'search_field':'all_fields'},timeout=15).json()
  out=[]
  for d in j.get('data',[])[:5]:
   a=d['attributes'];o={'title':a['title'],'url':d['links']['self']}
   for k in ['pub_created_display','isbn_s','oclc_s','lccn_s']:
    if k in a:o[k]=a[k]['attributes']['value']
   out.append(o)
  return {'query':q,'results':out}
 except Exception as e:return {'query':q,'error':str(e)}
with ThreadPoolExecutor(max_workers=6) as p:
 for x in p.map(f,queries):print(json.dumps(x,ensure_ascii=False))
