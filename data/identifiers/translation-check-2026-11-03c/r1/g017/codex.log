import requests,json
from concurrent.futures import ThreadPoolExecutor
urls=['https://www.loc.gov/item/hlas-bi93007163/?fo=json','https://www.editorabrasiliense.com.br/catalogo.php?id=162','https://openlibrary.org/search.json?title=Meninas+perdidas&author=Esteves','https://www.penguinrandomhouse.com/books/533608/metamorphoses-by-ovid-translated-by-david-raeburn-introduction-by-denis-feeney-cover-illustrated-by-coralie-bickford-smith/9780140447897/']
def fetch(url):
 try:
  r=requests.get(url,timeout=12)
  out=['URL '+url+' STATUS '+str(r.status_code)]
  if 'search.json' in url:out.append(r.text[:16000])
  elif 'fo=json' in url:out.append(r.text[:16000])
  else:
   from bs4 import BeautifulSoup
   s=BeautifulSoup(r.text,'html.parser').get_text(' ',strip=True)
   for term in ['ISBN','9780140447897','Escravo']:
    i=s.find(term)
    if i>=0:out.append(s[max(0,i-100):i+700])
  return '\\n'.join(out)
 except Exception as e:return url+' '+str(e)
with ThreadPoolExecutor(max_workers=4) as pool:
 for result in pool.map(fetch,urls): print(result)
