}

EDGE {
 "proposal_id": "pe135_parr_rel_05",
 "source": "joy_parr",
 "target": "consumption",
 "type": "connection",
 "relationship_kind": "contribution",
 "directed": true,
 "relationship": "Postwar Canadian consumption as a politics of nation, class and gender: domestic goods, designers and householders (1999)",
 "map_label": "Domestic goods, 1999",
 "evidence_note": "In-period, her own words: the abstract of 'Household Choices as Politics and Pleasure in 1950s Canada' (ILWCH 55, 1999, a special issue on class and consumption) reads 'How much consumption matters is a cultural difference, a shared national predicament, a politics grounded in the circumstances of class, and learned as a gendered responsibility', and asks 'When producers were not paramount in the regulation of consumption, to what priorities was commerce subsidiary?' Domestic Goods (1999) is unread here; as Brush quotes it (EH.NET, 2000, read in full), it is 'an archeology of the material, moral, and economic choices and constraints which formed Canadian commodity culture in the two decades after the Second World War' (p. 17). It asks 'How much can citizens talk back to manufacturers and the state about domestic goods?' (pp. 3–4). It sets itself against accounts that 'naturalize[d] these hortatory American norms as the intrinsic qualities of \"consumer society\"' (p. 11), and it places studies of material culture 'into unaccustomed company' (p. 3). Brush notes that Parr 'locates the history of consumption as a history primarily of women as consumers, in contrast to the male-dominated fields of design and manufacturing'. Criticism: Owram (BC Studies 129, 2001, read in full) finds the book's 'strength is in its parts rather than in some seamless thesis' (p. 103). He reads her as arguing that 'the assumption of consumer sovereignty is facile' (p. 104), and answers that 'Canadians, both men and women, preferred Fords to Volvos, and that is what they got' (p. 105). edge_843 (cdn_women_gender ↔ consumption, comparison) is title-level; this edge adds read evidence.",
 "source_ids": [
  "pe135_parr_ilwch_1999",
  "cdnsrc_parr_1999",
  "pe135_parr_brush_2000",
  "pe135_parr_owram_2001"
 ],
 "classification_basis": "editorial_review",
 "review_status": "needs_review",
 "target_strand": "consumption/gender_consumption",
 "target_strand_note": "gender_consumption ('Investigate the division of family labor, male and female consumer identities, class differences and state definitions; avoid one universal consumer') fits the 1999 abstract's nation, class and gender. household_labor (de Vries) is the alternative.",
 "roster_row": null,
 "include": true
}

EDGE {
 "proposal_id": "pe135_parr_rel_06",
 "source": "joy_parr",
 "target": "environment",
 "type": "connection",
 "relationship_kind": "contribution",
 "directed": true,
 "relationship": "Embodied, sensory histories of megaprojects and environmental change in Canada, 1953–2003 (2006–10)",
 "map_label": "Sensing changes, 2010",
 "evidence_note": "Dated 2006–2011; no claim here concerns her work before 2000. Sensing Changes: Technologies, Environments, and the Everyday, 1953–2003 (UBC Press, 2010) is unread here. As Jackson quotes it (Senses and Society 6:2, 2011, read in full), Parr seeks to move beyond 'representations . . . in language . . . , to open interpretive space in which to study the robust materiality of technologies, environments, and the everyday, to encounter them as directly and as fleshly as possible' (p. 9). Jackson describes chapters on the NATO base at Gagetown, nuclear power and heavy water on Lake Huron, the St Lawrence Seaway at Iroquois, the Columbia River reservoir and Walkerton's water, each read through a sense ('Smell and Risk', 'Taste and Expertise'). She adds that Parr counts proprioception, kinesthetics and proxemics among the senses (pp. 225–27). Jackson places the book in the UBC Press Nature/History/Culture series (p. 225). Rumiel (Left History 15:1, 2011, read in full) notes 'the people whose lives and senses of self had been transformed' by megaprojects (p. 189). She suggests that 'a comparative analysis of a related case in a Canadian Aboriginal or Inuit community' was a missed opportunity (p. 189). The environmental line begins earlier with 'Smells Like?: Sources of Uncertainty in the History of the Great Lakes Environment' (Environmental History 11:2, 2006; metadata only). A contribution: it records her later field, not influence on environmental history's formation.",
 "source_ids": [
