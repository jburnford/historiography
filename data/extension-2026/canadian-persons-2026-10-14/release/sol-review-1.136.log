 print('NODE',json.dumps(d['node'],ensure_ascii=False,indent=1))
 for e in d['proposed_edges']: print('\\nEDGE',e['proposal_id'],e['evidence_note'])
 print('ADDENDA',json.dumps(d.get('source_addenda'),ensure_ascii=False,indent=1))
PY" in /home/jic823/historiography
