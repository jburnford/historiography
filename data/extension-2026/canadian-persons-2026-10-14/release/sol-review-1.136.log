'parr/entry-draft.json':['In-period reviews read in full','\"proposal_id\": \"pe135_parr_rel_01\"','\"proposal_id\": \"pe135_parr_rel_04\"'],
'valverde/entry-draft.json':['\"proposal_id\": \"pe135_valverde_rel_01\"','\"proposal_id\": \"pe135_valverde_rel_03\"','\"proposal_id\": \"pe135_valverde_rel_04\"']}
for f,terms in checks.items():
 lines=(p/f).read_text().splitlines();print(f)
 for term in terms:print(term,[i+1 for i,l in enumerate(lines) if term in l])
