'release/editorial-additions.json':['PhD context: 67','\"node\": \"cdn_national_tradition\"','\"proposal_id\": \"pe135_berger_rel_03\"','\"proposal_id\": \"pe135_creighton_rel_01\"','\"proposal_id\": \"pe135_parr_rel_01\"','\"proposal_id\": \"pe135_parr_rel_04\"','\"proposal_id\": \"pe135_valverde_rel_03\"','\"proposal_id\": \"pe135_valverde_rel_04\"','In-period reviews read in full','\"edge_824\":','\"edge_798\":','\"edge_858\":','\"edge_861\":'],
