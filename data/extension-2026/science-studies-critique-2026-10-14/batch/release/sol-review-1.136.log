    def transform(self, before, packet):
        if before['revision_history'][-1]['version'] != packet['baseline_revision']:
            raise ValueError('Expected revision ' + packet['baseline_revision'])
        g = deepcopy(before)
        ids = {n['id'] for n in g['nodes']}
        for node in packet['nodes']:
            if node['id'] in ids:
                raise ValueError('Node exists: ' + node['id'])
            g['nodes'].append(deepcopy(node))
        people = {p['id'] for p in g['people']}
        for p in packet.get('new_people', []):
            if p['id'] in people:
                raise ValueError('Person exists: ' + p['id'])
            g['people'].append(deepcopy(p))
        for upd in packet['people_updates']:
            next(p for p in g['people'] if p['id'] == upd['id'])['node_id'] = upd['node_id']
        have = {s['id'] for s in g['sources']}
        for s in packet['sources']:
            if s['id'] in have:
                raise ValueError('Source exists: ' + s['id'])
            g['sources'].append(deepcopy(s))
        for s in g['sources']:
            add = packet['source_addenda'].get(s['id'])
            if add:
                v = s.setdefault('verification', {})
                v['note'] = (v.get('note', '') + f" Addendum {add['checked_on']}: {add['note']}").strip()
                if add['status'] == 'supporting_page_checked':
                    v['status'], v['checked_on'] = add['status'], add['checked_on']
        last = max(int(e['id'].split('_')[1]) for e in g['edges'])
        new_ids = {}
        for i, e in enumerate(packet['edges'], start=last + 1):
            new_ids[e['proposal_id']] = f'edge_{i:03d}'
            g['edges'].append(dict(id=new_ids[e['proposal_id']], **deepcopy(e)))
        for eid, upd in packet['edge_revisions'].items():
            next(e for e in g['edges'] if e['id'] == eid).update(deepcopy(upd))
        for ra in packet.get('roster_additions', []):
            node = next(n for n in g['nodes'] if n['id'] == ra['node'])
            if any(r['person_id'] == ra['row']['person_id'] for r in node['representative_people']):
                raise ValueError(f"Roster row exists: {ra['node']}/{ra['row']['person_id']}")
            row = deepcopy(ra['row'])
            if ra.get('proposal_id'):
                row['edge_id'] = new_ids[ra['proposal_id']]
            node['representative_people'].append(row)
        for re_ in packet['roster_edges']:
            node = next(n for n in g['nodes'] if n['id'] == re_['node'])
            next(r for r in node['representative_people'] if r['person_id'] == re_['person_id'])['edge_id'] = new_ids[re_['proposal_id']]
        g['revision_history'].append(dict(version=self.rev, date=self.day,
            acceptance_record=str((self.out / 'acceptance.json').relative_to(ROOT)), summary=self.cfg['summary'],
            added_node_ids=[n['id'] for n in packet['nodes']], added_edge_ids=list(new_ids.values()),
            revised_edge_ids=sorted(packet['edge_revisions'])))
        return g

    def accepted_graph(self):
        record = read(self.out / 'acceptance.json')
}

function strandGuide(n) {
  if (!n.strands?.length) return '';
  return `<section class="strand-guide" aria-label="Approaches within this entry"><h3>Different approaches within this entry</h3><p class="fine-print">Overlapping approaches and debates, not a sequence of schools replacing one another.</p>${n.strands.map(branch => `<details class="strand${branch.intervention_year ? ' strand-extension' : ''}"><summary>${esc(branch.title)}${branch.intervention_year ? `<span class="strand-year">${esc(branch.intervention_year)}</span>` : ''}</summary>${branch.intervention_year ? `<p class="strand-meta">Selected intervention · ${esc(branch.intervention_year)} ${reviewBadge(branch.review_status)}<span class="fine-print"> A work's year is not the field's origin or a career boundary.</span></p>` : ''}<p>${esc(branch.focus)}</p><p class="strand-people">${branch.person_ids.map(id => `<a href="${esc(personHref(id))}">${esc(personById.get(id)?.label || id)}</a>`).join(' · ')}</p><p class="person-work">${esc(branch.works)}</p>${strandCredits(branch)}${branch.claim_ids?.length ? `<details class="strand-claims"><summary>Exact claims · ${branch.claim_ids.length}</summary>${claimCards(branch.claim_ids)}</details>` : ''}<details><summary>Reading references</summary><p class="fine-print">These readings have different scopes; see their source notes.</p>${sourceList(branch.source_ids)}</details></details>`).join('')}</section>`;
}
function corePeople(n) {
  if (!n.representative_people?.length) return '';
  return `<section class="core-people" aria-label="Historians and contributors for this entry"><div class="section-heading"><div><p class="eyebrow">THE PEOPLE BEHIND THIS ENTRY</p><h3>Historians & contributors</h3></div><a class="text-link" href="${esc(href({section:'',edge:'',page:0,kind:'',neighborLayer:''}))}">Explore works & approaches →</a></div><ul>${n.representative_people.map(r => `<li data-person="${r.person_id}"><a href="${esc(personHref(r.person_id))}">${esc(personById.get(r.person_id).label)}</a><span>${esc(PERSON_ROLES[r.role])}</span></li>`).join('')}</ul><p class="fine-print">All ${n.representative_people.length} people in this entry’s selection. Roles distinguish historians, resources, and critics; this roster is not an influence diagram.</p></section>`;
}
function schoolPeople() {
  const n = nodeById.get(state.node);
  const reps = n.representative_people;
  return `${crumbs([`<a href="${esc(href({node: '', person: '', edge: '', page: 0, section: ''}))}">${state.pathway ? 'Back to pathway' : 'Back to entries'}</a>`, `<span aria-current="page">${esc(n.label)}</span>`])}
    <div class="section-heading"><div><p class="eyebrow">03 / MEET THE HISTORIANS & CONTRIBUTORS</p><h2>${esc(n.label)}</h2></div><span class="count">${reps.length} people in this selection</span></div>
    ${schoolTabs(n)}<div class="school-layout"><section aria-label="Representative people"><p class="context-note">A selective guide to the people behind this entry. The labels distinguish historians, intellectual resources, and critics; inclusion does not imply a shared doctrine or formal membership.</p>
      ${extensionSection(n)}${strandGuide(n)}<div class="people-grid">${pageSlice(reps, 12).map(rep => personCard(personById.get(rep.person_id), rep)).join('')}</div>${pagination(reps.length, 12)}</section>
      <aside class="reading-panel" aria-label="Entry details">${nodeDetail(n)}</aside></div>`;
}
