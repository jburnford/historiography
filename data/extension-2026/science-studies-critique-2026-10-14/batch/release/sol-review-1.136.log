NODE sts
{
  "label": "Science and technology studies / STS",
  "period": "period_2",
  "description": "An interdisciplinary field examining how knowledge, technologies, institutions, and social arrangements develop together. Historical, sociological, ethnographic, and policy-oriented inquiries coexist. SSK and laboratory studies contribute to STS but do not define its entire scope. Knorr Cetina’s comparative laboratory cultures, Harding’s feminist epistemology, and Sussex/Cornell institution building add distinct approaches and histories.",
  "representative_people": [
    {
      "person_id": "sheila_jasanoff",
      "role": "contributor",
      "context": "Studies how expert advice establishes the boundary between science and public decisions; also builds interdisciplinary institutions.",
      "works": "The Fifth Branch: Science Advisers as Policymakers (1990); Handbook of Science and Technology Studies (1995), co-editor",
      "source_ids": [
        "sts",
