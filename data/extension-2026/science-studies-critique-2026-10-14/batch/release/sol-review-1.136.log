      ],
      "focus": "The industrious-revolution argument connects demand with household labor, including unequal interests and negotiation among members.",
      "works": "“The Industrial Revolution and the Industrious Revolution” (1994)",
      "source_ids": [
        "de_vries_industrious"
      ],
      "basis": "editorial_distinction"
    },
    {
