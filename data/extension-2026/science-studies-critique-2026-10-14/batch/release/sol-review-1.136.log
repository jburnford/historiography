  "label": "Linguistic turn / poststructuralism",
  "period": "period_2",
  "description": "Examines how language, narrative, discourse, and power shape historical knowledge and subject formation. Narrative theory, structuralist inheritances, and poststructuralist critiques overlap but are not interchangeable. This node groups debates rather than identifying one school.",
  "representative_people": [
    {
      "person_id": "foucault",
      "role": "contributor",
      "context": "Discourse, genealogy and subject formation are related, changing inquiries; institutional and practical relations enter the account. Historians adapt and criticize them in different ways.",
      "works": "The Archaeology of Knowledge (1969); “Nietzsche, Genealogy, History” (1971); “The Subject and Power” (1982)",
      "source_ids": [
        "foucault",
        "foucault_archaeology_primary",
        "foucault_genealogy_primary",
        "foucault_subject_power_primary"
      ],
      "basis": "source_review"
    },
    {
      "person_id": "derrida",
      "role": "contributor",
      "context": "Questions conceptual hierarchies and conditions of signification through close reading and institutional questions; no mechanical rule permits arbitrary interpretation.",
      "works": "Of Grammatology (1967); “Letter to a Japanese Friend” (1983); Archive Fever (1994/1996)",
      "source_ids": [
        "derrida",
        "derrida_grammatology_corrected",
        "derrida_japanese_letter_primary",
        "derrida_archive_primary"
      ],
      "basis": "source_review"
    },
