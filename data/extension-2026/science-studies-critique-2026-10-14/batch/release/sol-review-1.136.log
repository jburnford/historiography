NODE ssk
{
  "label": "Sociology of scientific knowledge / SSK",
  "period": "period_2",
  "description": "Investigates how scientific beliefs become accepted within social practices and institutions. The Edinburgh Strong Programme seeks causal explanations of both accepted and rejected knowledge using the same kinds of explanation. SSK includes different programmes; it is neither all sociology of science nor all STS. Collins’s replication studies and Pinch’s work on controversies expose additional empirical programmes; these differ from treating SSK as only Bloor’s principles. Bloor explicitly includes material causes and rejects equating symmetry with equal credibility. His disagreement with Latour concerns the analytical roles of objects and society.",
  "representative_people": [
    {
      "person_id": "david_bloor",
      "role": "contributor",
      "context": "Sociology of scientific knowledge.",
      "works": "Knowledge and Social Imagery (1976)",
      "source_ids": [
        "ssk",
        "kuhn"
      ],
      "basis": "curated_entry"
    },
    {
      "person_id": "barry_barnes",
      "role": "contributor",
      "context": "Explains scientific knowing through observation, interpretation and collective practices.",
