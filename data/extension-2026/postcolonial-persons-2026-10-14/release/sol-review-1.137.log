#!/bin/bash
# usage: ocr.sh PDF OUTDIR PREFIX [FIRST LAST]
pdf="$1"; out="$2"; pre="$3"; first="${4:-1}"; last="${5:-}"
mkdir -p "$out"
if [ -n "$last" ]; then
  pdftoppm -f "$first" -l "$last" -r 300 -gray "$pdf" "$out/$pre"
else
  pdftoppm -r 300 -gray "$pdf" "$out/$pre"
fi
for f in "$out/$pre"-*.pgm; do
  tesseract "$f" "${f%.pgm}" >/dev/null 2>&1
  rm -f "$f"
done
ls "$out" | grep -c "^$pre-.*txt$"

