/bin/bash -lc "python3 -B - <<'PY'
import json
from scripts.apply_person_entries import Batch
b=Batch('data/extension-2026/period4-wave1-2026-10-23');g=b.transform(json.load(open('historiography-1920-2000.json')),json.load(open(b.packet)))
for n in g['nodes']:
 if n['id'] not in ['environment','william_cronon','donald_worster']:continue
 print(n['id'])
 for e in n['chronology']['events']:print(e['id'],e['date'],e['label'],'|',e['source_ids'],'|',e['support'])
PY" in /home/jic823/historiography
