/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
p=Path('data/extension-2026/period4-wave1-2026-10-23')
for name in ['william_cronon','donald_worster']:
 d=json.load(open(p/name/'entry-draft.json'));print(name)
 for k,v in d.items():
  if k in ['proposed_edges','edges_considered_not_proposed']:print(k,json.dumps(v,ensure_ascii=False,separators=(',',':')))
 print((p/name/'NOTES.md').read_text())
