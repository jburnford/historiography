1_2026-10-23"},{"id":"worster_bancroft_1980","label":"Bancroft Prize for Dust Bowl","kind":"award","track":"context","date":{"year":1980,"precision":"year"},"source_ids":["graph:p4c_bancroft_list"],"support":"Columbia's list of previous awards enters 'Dust Bowl: The Southern Plains in the 1930s' under 1979, the book's year; the prize for books of 1979 was made in 1980. Dated 1980 at the coordinator's decision; the Columbia listing is the only source.","basis":"period4_wave1_2026-10-23"},{"id":"worster_rivers_1985","label":"Rivers of Empire: Water, Aridity, and the Growth of the American West","kind":"publication","track":"contributions","date":{"year":1985,"precision":"year"},"source_ids":["graph:pe131_worster_rivers_1985"],"support":"Pantheon 1985 (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_dirty_thirties_1986","label":"“The Dirty Thirties: A Study in Agricultural Capitalism” (Great Plains Quarterly)","kind":"publication","track":"contributions","date":{"year":1986,"precision":"year"},"source_ids":["graph:worster_dirty_thirties"],"support":"Great Plains Quarterly 6:2 (1986); read in full (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_mcdean_1986","label":"McDean, “Dust Bowl Historiography”","kind":"reception_publication","track":"reception","date":{"year":1986,"precision":"year"},"source_ids":["graph:mcdean_dust_historiography"],"support":"Great Plains Quarterly 6:2 (1986); read (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_hennessey_1987","label":"Hennessey's review of Rivers of Empire","kind":"reception_publication","track":"reception","date":{"year":1987,"precision":"year","month":10},"source_ids":["graph:pe131_worster_hennessey_1987"],"support":"Journal of San Diego History 33:4 (October 1987); read in full (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_doing_1988","label":"“Appendix: Doing Environmental History” (The Ends of the Earth)","kind":"publication","track":"contributions","date":{"year":1988,"precision":"year"},"source_ids":["graph:pe131_worster_ends_1988"],"support":"Cambridge 1988; read in an abridged reprint (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_kansas_1989","label":"Hall Distinguished Professor of American History, University of Kansas","kind":"life","track":"context","date":{"year":1989,"precision":"year"},"source_ids":["graph:p4c_worster_origins_bio"],"support":"Origins author page: 'from 1989 until his retirement'.","basis":"period4_wave1_2026-10-23"},{"id":"worster_merchant_reply_1990","label":"Merchant's round-table response, “Gender and Environmental History”","kind":"reception_publication","track":"reception","date":{"year":1990,"precision":"year","month":3},"source_ids":["graph:pe131_merchant_jah_1990"],"support":"JAH 76:4 (March 1990), 1117–1121; read in full (graph record). White's and Cronon's responses in the same round table are unread.","basis":"period4_wave1_2026-10-23"},{"id":"worster_cronon_stories_1992","label":"Cronon's “A Place for Stories” reads Dust Bowl as prophecy","kind":"reception_publication","track":"reception","date":{"year":1992,"precision":"year","month":3},"source_ids":["graph:pe131_cronon_place_stories_1992"],"support":"JAH 78:4 (March 1992); pp. 1347–1351 read (graph record).","basis":"period4_wave1_2026-10-23"},{"id":"worster_wealth_1993","label":"The Wealth of Nature: Environmental History and the Ecological Imagination","kind":"publication","track":"contributions","date":{"year":1993,"precision":"year"},"source_ids":["graph:pe131_worster_wealth_1993"],"support":"OUP 1993 (graph record); OUP's online edition is the paperback of 8 December 1994 (p4c_worster_wealth_oup).","basis":"period4_wave1_2026-10-23"},{"id":"worster_river_2001","label":"A River Running West: The Life of John Wesley Powell","kind":"publication","track":"contributions","date":{"year":2001,"precision":"year"},"source_ids":["graph:p4c_worster_river_2001"],"support":"OUP 2001; Crossref review records 2001–02; unread.","basis":"period4_wave1_2026-10-23"},{"id":"worster_muir_essay_2005","label":"“John Muir and the Modern Passion for Nature” (Environmental History)","kind":"publication","track":"contributions","date":{"year":2005,"precision":"year","month":1},"source_ids":["graph:p4c_worster_muir_2005"],"support":"Environmental History 10:1 (January 2005), 8–19; unread.","basis":"period4_wave1_2026-10-23"},{"id":"worster_passion_2008","label":"A Passion for Nature: The Life of John Muir","kind":"publication","track":"contributions","date":{"year":2008,"precision":"year"},"source_ids":["graph:p4c_worster_passion_2008"],"support":"OUP 2008; reviews 2009; unread.","basis":"period4_wave1_2026-10-23"},{"id":"worster_scholarly_distinction_2012","label":"AHA Award for Scholarly Distinction (with Alfred Crosby)","kind":"award","track":"context","date":{"year":2012,"precision":"year"},"source_ids":["graph:p4c_aha_scholarly_distinction"],"support":"AHA list of past recipients: '2012: Donald Worster, Univ. of Kansas'; presented at the January 2013 meeting.","basis":"period4_wave1_2026-10-23"},{"id":"worster_retirement_2012","label":"Retires from Kansas; senior professor, School of History, Renmin University of China","kind":"life","track":"context","date":{"year":2012,"precision":"year"},"source_ids":["graph:p4c_worster_origins_bio"],"support":"The Origins page gives the Renmin post and 'until his retirement' without a year; the year 2012 comes from a search snippet of a Portuguese-language interview and is probable, not verified.","basis":"period4_wave1_2026-10-23"},{"id":"worster_shrinking_2016","label":"Shrinking the Earth: The Rise and Decline of American Abundance","kind":"publication","track":"contributions","date":{"year":2016,"precision":"year"},"source_ids":["graph:p4c_worster_shrinking_2016"],"support":"OUP 2016; Crossref; known through two read reviews.","basis":"period4_wave1_2026-10-23"},{"id":"worster_gratale_2017","label":"Gratale's review (European Journal of American Studies)","kind":"reception_publication","track":"reception","date":{"year":2017,"precision":"year","month":8,"day":1},"source_ids":["graph:p4c_gratale_2017"],"support":"Online 1 August 2017; read in full.","basis":"period4_wave1_2026-10-23"},{"id":"worster_collomb_2017","label":"Collomb's review (Miranda 15): 'the greatest US environmental historian'","kind":"reception_publication","track":"reception","date":{"year":2017,"precision":"year","month":9,"day":20},"source_ids":["graph:p4c_collomb_2017"],"support":"Online 20 September 2017; read in full.","basis":"period4_wave1_2026-10-23"}],"intervals":[],"continuation":{"status":"not_asserted","basis":"No continuous historical duration or ending is established by this selection."},"interpretation":"Adds twenty dated points (works 1977–2016; prizes and posts; readers from McDean 1986 to Collomb 2017); the 1979 and 1990 events are unchanged. The biographies of 2001 and 2008 are dated from metadata.","prepared_on":"2026-10-23","editorial_record":"data/production-batches/period4-1.156/acceptance.json","retain":["The 1990 JAH text, the biographies and the 2005 Muir essay are unread."],"unresolved":["Bancroft Prize: Columbia lists Dust Bowl under 1979 (the book's year); dated 1980 here.","Retirement year 2012 and the Renmin appointment rest on a search snippet and the Origins page."]},"reason":"Period-4 wave 1 (data/extension-2026/period4-wave1-2026-10-23/evidence-environment.md): dated contributions, reception and context added; the existing events are unchanged."}]
source_field_sets [{"id":"derrida_archive_primary","field":"url","expect":"https://monoskop.org/images/e/ef/Derrida_Jacques_Archive_Fever_A_Freudian_Impression_1996.pdf","value":"https://press.uchicago.edu/ucp/books/book/chicago/A/bo27619045.html"},{"id":"derrida_archive_primary","field":"verification.note","expect":"Title, copyright and lecture note, complete printed pp. 1–5 including p. 4 note 1, and pp. 7–15 read. Distinguishes archive/authority/consignation from spontaneous memory, explicitly uses Combe, and reworks Freud’s destruction drive and Mystic Pad with questions about recording technologies. Theoretical claims are attributed, not empirical confirmation. Freud, Combe and the earlier Derrida essay quoted here are not independently collated. Later argument, including the developed Yerushalmi exchange, remains unread. French/Diacritics 1995, English book 1996 and paperback dates are not conflated.","value":"Title, copyright and lecture note, complete printed pp. 1–5 including p. 4 note 1, and pp. 7–15 read. Distinguishes archive/authority/consignation from spontaneous memory, explicitly uses Combe, and reworks Freud’s destruction drive and Mystic Pad with questions about recording technologies. Theoretical claims are attributed, not empirical confirmation. Freud, Combe and the earlier Derrida essay quoted here are not independently collated. Later argument, including the developed Yerushalmi exchange, remains unread. French/Diacritics 1995, English book 1996 and paperback dates are not conflated. Period-4 wave 1 (2026-10-23): the reading of 2026-09-12 was made through a PDF on a mirror host of the kind the 2026-10-19 provenance rule excludes; the link is replaced by the University of Chicago Press page (fetched 2026-10-23: © 1996, viii + 114 pp., Religion and Postmodernism), which does not reproduce the text, and the Diacritics printing is recorded as p4a_derrida_diacritics_1995 (DOI 10.2307/465144). The passages have not been re-read through an eligible route; edge_587–589 and the roster rows stand on the earlier record."},{"id":"pe131_worster_wealth_1993","field":"url","expect":"https://archive.org/details/wealthofnatureen00wors","value":"https://doi.org/10.1093/oso/9780195092646.001.0001"},{"id":"pe131_worster_natures_economy_1977","field":"url","expect":"https://archive.org/details/natureseconomyro0000wors","value":"https://www.cambridge.org/9780521468343"},{"id":"pe131_worster_rivers_1985","field":"url","expect":"https://archive.org/details/riversofempirewa00wors","value":"https://global.oup.com/academic/product/rivers-of-empire-9780195078060"},{"id":"pe131_extras_mcneill_2003","field":"url","expect":"https://www.williamcronon.net/writing/H701_McNeill.pdf","value":"https://doi.org/10.1046/j.1468-2303.2003.00255.x"}]
