import json
from pathlib import Path
p=Path('data/extension-2026/period4-wave1-2026-10-23')
for name in ['archival_turn','ann_laura_stoler']:
 print('\\nDRAFT',name)
 d=json.load(open(p/name/'entry-draft.json'))
 for k,v in d.items():
  print(k)
  if isinstance(v,list):
   for item in v:print(json.dumps(item,ensure_ascii=False,separators=(',',':')))
  else: print(json.dumps(v,ensure_ascii=False,separators=(',',':')))
 print('NOTES');print((p/name/'NOTES.md').read_text())
PY" in /home/jic823/historiography
