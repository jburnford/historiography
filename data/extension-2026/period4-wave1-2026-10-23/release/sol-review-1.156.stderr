import json
from pathlib import Path
p=Path('data/extension-2026/period4-wave1-2026-10-23/environment');d=json.load(open(p/'entry-draft.json'))
for k,v in d.items():
 if k not in ['new_sources','new_people','source_addenda']:print(k,json.dumps(v,ensure_ascii=False,separators=(',',':')))
print((p/'NOTES.md').read_text())
PY" in /home/jic823/historiography
