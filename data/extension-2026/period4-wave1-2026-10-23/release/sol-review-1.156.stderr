  "new_strands": [
    {
      "node": "settler_colonialism",
      "strand": {
        "id": "wolfe_veracini_structure_debate",
        "title": "Structure and its end: Wolfe and Veracini read together",
        "focus": "The dissertation data register 'Wolfe and Veracini' as the field's first two-sided citing (History PhD citation graph, release 2026-10-23: 0% of Canada + US theses in 2000–09, 3.0% in 2020–25). The difference in their own words: Wolfe's structure is 'a continuity through time' that 'does not stop' with frontier homicide and 'has not been subject to election results' (2006); Veracini accepts the 'frequently quoted passage' and adds that 'the structure persistently pursues a specific end point' and 'extinguishes itself', so that settler colonialism 'covers its tracks' (2011). Englert reads both as drawing 'a sharp analytical separation' between eliminatory settler and exploitative franchise colonies and finds the separation does not fit Africa or South America (2020); Macoun and Strakosch find in the structure a 'colonial fatalism' and recall the label 'very much a structuralist stuck in a poststructuralist world' (2013). Veracini's obituary records Wolfe as 'still a Marxist' of 'the young Marx' for whom 'things are not things in themselves but relationships' (2016).",
        "person_ids": [
          "patrick_wolfe",
          "lorenzo_veracini",
          "sai_englert",
          "alissa_macoun",
          "elizabeth_strakosch"
        ],
        "works": "Wolfe, \"Settler Colonialism and the Elimination of the Native\" (2006); Veracini, \"Introducing settler colonial studies\" (2011) and \"Patrick Wolfe (1949–2016)\" (2016); Macoun and Strakosch, \"The Ethical Demands of Settler Colonial Theory\" (2013); Englert, \"Settlers, Workers, and the Logic of Accumulation by Dispossession\" (2020).",
        "source_ids": [
          "screq_wolfe_2006",
          "screq_veracini_2011",
          "p4b_veracini_2011_deposit",
          "p4b_englert_2020",
          "p4b_macoun_strakosch_2013_qut",
          "p4b_veracini_wolfe_obituary_2016"
        ],
        "basis": "editorial_distinction"
      }
    },
    {
      "node": "settler_colonialism",
      "strand": {
        "id": "canadian_uptake_2009_2020",
        "title": "Canadian history beside and under the frame, 2009–2020",
        "focus": "Works that Canadian PhDs read with Wolfe and Veracini, few of which adopt his vocabulary. Treaty history (Miller 2009), racialisation and law in British Columbia's 'contact zone' (Mawani 2009), settler self-examination after residential schools (Regan 2010; Battell Lowman and Barker 2015: 'Canada and Settler Colonialism', 'It's Always All About the Land'), starvation policy (Daschuk 2013), Indigenous women's work 'in modern Native ways' (McCallum 2014), the TRC's finding that Canada's policy aimed 'to eliminate Aboriginal governments … and … cause Aboriginal peoples to cease to exist as distinct … entities' and 'can best be described as \"cultural genocide\"' (2015), imperial family and archive (Perry 2015), women homesteaders in 'the spadework of British colonialism' who 'took part in dispossessing Indigenous people' (Carter 2016), the settler-colonial city (Hugill 2017), the settler order in working-class history (Burrill 2019), Japanese Canadian dispossession (Stanger-Ross 2020), and Harris's reflections (2020). Veracini's own history says the Canadian historiography was 'late in adopting settler colonialism as a category of analysis' (2013). Publisher descriptions, not the books, are read; none of Miller, Daschuk, McCallum, Perry 2015, Carter 2016 or Stanger-Ross uses the phrase on its page.",
        "person_ids": [
          "james_rodger_miller",
          "renisa_mawani",
          "paulette_regan",
          "emma_battell_lowman",
          "adam_j_barker",
          "james_daschuk",
          "mary_jane_logan_mccallum",
          "adele_perry",
          "sarah_carter",
          "david_hugill",
          "fred_burrill",
          "jordan_stanger_ross",
          "cole_harris"
        ],
        "works": "Miller, Compact, Contract, Covenant (2009); Mawani, Colonial Proximities (2009); Regan, Unsettling the Settler Within (2010); Daschuk, Clearing the Plains (2013); McCallum, Indigenous Women, Work, and History (2014); Battell Lowman and Barker, Settler (2015); TRC, Honouring the Truth, Reconciling for the Future (2015); Perry, Colonial Relations (2015); Carter, Imperial Plots (2016); Hugill, \"What Is a Settler-Colonial City?\" (2017); Burrill, \"The Settler Order Framework\" (2019); Stanger-Ross, ed., Landscapes of Injustice (2020); Harris, A Bounded Land (2020).",
        "source_ids": [
          "p4b_miller_2009",
          "p4b_mawani_2009",
          "screq_regan_2010",
          "screq_battell_lowman_barker_2015",
          "screq_daschuk_2013",
          "p4b_mccallum_2014",
          "p4b_trc_summary_2015",
          "p4b_pm_backgrounder_2015",
          "p4b_perry_2015",
          "p4b_carter_2016",
          "p4b_hugill_2017",
          "screq_burrill_2019",
          "p4b_stanger_ross_2020",
          "screq_harris_2020",
          "p4b_veracini_2013_deposit"
        ],
        "basis": "editorial_distinction"
      }
    },
    {
      "node": "settler_colonialism",
      "strand": {
        "id": "field_institutions",
        "title": "A field's institutions: journal, associations, memorials",
        "focus": "NAISA founded 2008 after an ASA panel of 2002 asked whether American Studies could be 'an intellectual home' for Native studies (Kauanui). Settler Colonial Studies founded 2011 'in an open access format (entirely run on volunteer labour)' and moved to Taylor & Francis 'within two years' (Snelgrove et al.; Edmonds and Carey 2013). Wolfe edited paired issues of the journal and of AICRJ (2013) and answered the binary charge with The Settler Complex (2016). ASA 2015: Goldstein's reappraisal and Warrior's count of panels. Wolfe's death (18 February 2016) brought obituaries from the journal (Veracini), AICRJ (Goeman), Aboriginal History (Birch) and an American Quarterly forum (2017); a Festschrift followed (Race, Place, Trace, 2022).",
        "person_ids": [
          "lorenzo_veracini",
          "patrick_wolfe",
          "j_kehaulani_kauanui",
          "mishuana_goeman"
        ],
