igible route; edge_587–589 and the roster rows stand on the earlier record."}, {"id": "pe131_worster_wealth_1993", "field": "url", "expect": "https://archive.org/details/wealthofnatureen00wors", "value": "https://doi.org/10.1093/oso/9780195092646.001.0001"}, {"id": "pe131_worster_natures_economy_1977", "field": "url", "expect": "https://archive.org/details/natureseconomyro0000wors", "value": "https://www.cambridge.org/9780521468343"}, {"id": "pe131_worster_rivers_1985", "field": "url", "expect": "https://archive.org/details/riversofempirewa00wors", "value": "https://global.oup.com/academic/product/rivers-of-empire-9780195078060"}, {"id": "pe131_extras_mcneill_2003", "field": "url", "expect": "https://www.williamcronon.net/writing/H701_McNeill.pdf", "value": "https://doi.org/10.1046/j.1468-2303.2003.00255.x"}]

