people_update {"id": "michel_rolph_trouillot", "node_id": "michel_rolph_trouillot", "new": true, "label": "Michel-Rolph Trouillot", "identity_note": "Haitian anthropologist and historian (1949–2012; Duke 1983–88, Johns Hopkins 1988–98, University of Chicago 1998–2012); Silencing the Past (1995). Added in period-4 wave 1. Wikidata Q6836249 checked by QLever SPARQL on 2026-10-23; to be recorded in data/people-wikidata.json in the usual way. Not to be confused with his siblings Évelyne Trouillot (novelist), Lyonel Trouillot (writer) and Jocelyne Trouillot-Lévy, or with his father Ernest and uncle Hénock Trouillot (historians)."}
wikidata_check {"qid": "Q6836249", "verdict": "correct", "method": "QLever SPARQL (qlever.dev/api/wikidata, 2026-10-23): label, description, P569, P570, P106 labels, P214, P19; no wbsearchentities; the WikidataMCP endpoint failed to connect.", "statements_seen": "Label 'Michel-Rolph Trouillot'; description 'Haitian academic and anthropologist'; P569 1949-11-26; P570 2012-07-05; P19 Port-au-Prince; P106 historian, academic, anthropologist; P214 VIAF 2600615. The death date matches the Chicago obituary."}
proposed_edges [{"proposal_id": "p4A_rel_20", "source": "michel_rolph_trouillot", "target": "archival_turn", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "Silencing the Past (1995) placed the archive inside the production of history: silences enter at four moments (sources, archives, narratives, 'history in the final instance'); 'in history, power begins at the source' and 'archives are the institutions that organise facts and sources' (as quoted by Davidson, 2020); Stoler's 2002 essay cites it three times", "map_label": "Silences and the making of archives, 1995", "evidence_note": "Davidson 2020 (read; quotations unpaginated); the four moments as later writers list them (the Cambridge Core summary of Strickland 2021, read); Beacon contents; Stoler 2002 nn. 24, 38, 49 (reference list read). Body unread. Wording awaits re-verification on a library copy of Silencing the Past, ch. 1 (precedent: the Chandavarkar 1997 quotations in 1.152).", "source_ids": ["p4a_trouillot_silencing_1995", "p4a_davidson_overland_2020", "p4a_stoler_archives_2002"], "classification_basis": "editorial_review", "target_strand": "archival_turn/site_of_power", "roster_row": {"node": "archival_turn", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_21", "source": "michel_rolph_trouillot", "target": "atlantic", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "The Haitian Revolution as 'An Unthinkable History' (1995, ch. 3): the 'historical guild' facilitated 'the relegation to an historical backburner of the three themes to which [the Haitian Revolution] was linked: racism, slavery and colonialism' (p. 98, as quoted by Craipain); Ti dife boule (1977) told the revolution in Creole; Haiti: State against Nation (1990) its Duvalierist legacy", "map_label": "Haiti's unthinkable revolution, 1977–95", "evidence_note": "Craipain 2024 (read in full), quoting p. 98 and dating Ti dife boule to the Brooklyn Koléksion Lakansièl, 1977; the Chicago obituary and finding aid for the 1977 and 1990 books; Bulamah, Goyatá and Pereira on the 1990 book as 'the classic' (para. 2, read). Chapter 3 unread.", "source_ids": ["p4a_craipain_hnet_2024", "p4a_trouillot_uchicago_obit_2012", "p4a_trouillot_papers_ead", "p4a_bulamah_vibrant_2020"], "classification_basis": "editorial_review", "target_strand": "atlantic/slave_society", "roster_row": {"node": "atlantic", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_22", "source": "michel_rolph_trouillot", "target": "anthropology", "type": "critique", "relationship_kind": "critique", "directed": true, "relationship": "'Anthropology and the Savage Slot: The Poetics and Politics of Otherness' (1991; 2003) and Global Transformations: 'Anthropology discovered globalization before the term became fashionable' (chapter abstract); the discipline's concepts of culture, modernity and globalization as 'North Atlantic universals' (as read by Bulamah, Goyatá and Pereira, 2020); 'Adieu, Culture: A New Duty Arises'", "map_label": "The savage slot and North Atlantic universals, 1991–2003", "evidence_note": "Springer abstract of ch. 2 (read); Springer contents; Bulamah et al. 2020, para. 5 (read); Duke contents of Trouillot Remixed for the essay's place. The 'savage slot' thesis itself was not read; the label uses the title.", "source_ids": ["p4a_trouillot_global_2003", "p4a_trouillot_savage_slot_2003", "p4a_bulamah_vibrant_2020", "p4a_trouillot_remixed_2021"], "classification_basis": "editorial_review", "target_strand": "anthropology/writing", "roster_row": {"node": "anthropology", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_23", "source": "michel_rolph_trouillot", "target": "global", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "Global Transformations (2003): 'North Atlantic Fictions: Global Transformations, 1492–1945', 'A Fragmented Globality' and 'The Anthropology of the State in the Age of Globalization' (2001) set the North Atlantic's production of 'the West' against the anthropology of globalization (Springer description); Peasants and Capital (1988) placed Dominica 'in the World Economy'", "map_label": "The West as a North Atlantic fiction, 1988–2003", "evidence_note": "Springer book page (description and contents, read); the Chicago obituary for the 1988 book. Bodies unread.", "source_ids": ["p4a_trouillot_global_2003", "p4a_trouillot_uchicago_obit_2012"], "classification_basis": "editorial_review", "target_strand": "global/connected", "roster_row": {"node": "global", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_24", "source": "michel_rolph_trouillot", "target": "anticolonial", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "Ti dife boule sou istwa Ayiti (Brooklyn, 1977), a Creole history of the revolution written in exile by a group that 'harbored an anti- or rather a counter-academism … to oppose the knowledge embargo imposed by the \"official\" venues of knowledge production' (Lyonel Trouillot, as quoted by Craipain); 'virtually absent from bibliographies in North Atlantic academia' until the 2021 translation", "map_label": "A Creole history against the guild, 1977–2021", "evidence_note": "Craipain 2024 (read in full), quoting the Liverpool edition's preface (p. xxiii) and Jonassaint's afterword (p. 182); the Chicago obituary; the finding aid ('fleeing the Duvalier regime', 1968).", "source_ids": ["p4a_craipain_hnet_2024", "p4a_trouillot_uchicago_obit_2012", "p4a_trouillot_papers_ead"], "classification_basis": "editorial_review", "target_strand": "anticolonial/enslaved_revolution", "roster_row": {"node": "anticolonial", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_25", "source": "michel_rolph_trouillot", "target": "black", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "Silencing the Past 'remains an unavoidable reference for anyone navigating the streams of Black and Caribbean studies in academia and beyond' (Craipain, 2024); 'The Odd and the Ordinary' (1990) refused Haiti's image as an exception 'dominated by Christianity, capitalism, and whiteness' (1990, p. 7, as quoted by Bulamah, Goyatá and Pereira)", "map_label": "Haiti in Black and Caribbean studies, 1990–2024", "evidence_note": "Craipain 2024 (read in full); Bulamah et al. 2020, paras 3–4 (read), quoting 1990a: 7.", "source_ids": ["p4a_craipain_hnet_2024", "p4a_bulamah_vibrant_2020"], "classification_basis": "editorial_review", "target_strand": "black/archives", "roster_row": {"node": "black", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_26", "source": "michel_rolph_trouillot", "target": "post", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "'A critical indictment of Western historiography and its systematic disregard for Haiti's contribution to emancipatory struggles and decolonial politics', offering 'an eye-opening analysis of the epistemological failures and ideological maneuverings intrinsic to history telling as a professional activity' (Craipain, 2024); 'As Trouillot taught us, not all narratives or narrators are created equal'", "map_label": "The guild's silences, 1995", "evidence_note": "Craipain 2024 (read in full). Trouillot's own words for this claim are only Davidson's unpaginated quotations ('Power is constitutive of the story'). Wording awaits re-verification on a library copy of Silencing the Past, ch. 1 (precedent: the Chandavarkar 1997 quotations in 1.152).", "source_ids": ["p4a_craipain_hnet_2024", "p4a_davidson_overland_2020"], "classification_basis": "editorial_review", "target_strand": "post/imperial_knowledge", "roster_row": {"node": "post", "person_id": "michel_rolph_trouillot"}}, {"proposal_id": "p4A_rel_27", "source": "michel_rolph_trouillot", "target": "memory", "type": "connection", "relationship_kind": "contribution", "directed": true, "relationship": "'The Presence in the Past' (1995, ch. 5), 'Good Day, Columbus: Silences, Power, and Public History (1492–1892)' and 'Abortive Rituals: Historical Apologies in the Global Era' (2000) took commemoration and apology as moments of 'retrospective significance'; Davidson (2020): 'Silences are produced and reproduced throughout any telling of a story'", "map_label": "Commemoration and apology as history-making, 1995–2000", "evidence_note": "Chapter and essay titles (Beacon and Duke contents, read); Davidson 2020 (read). Thin: no body read; 'retrospective significance' is the later writers' label for the fourth moment. Wording awaits re-verification on a library copy of Silencing the Past, ch. 1 (precedent: the Chandavarkar 1997 quotations in 1.152).", "source_ids": ["p4a_trouillot_silencing_1995", "p4a_trouillot_remixed_2021", "p4a_davidson_overland_2020"], "classification_basis": "editorial_review", "target_strand": "memory/archive_authority", "roster_row": {"node": "memory", "person_id": "michel_rolph_trouillot"}}]
