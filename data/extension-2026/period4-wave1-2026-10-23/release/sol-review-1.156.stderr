roster_additions [{"node":"environment","proposal_id":null,"row":{"person_id":"tina_loo","role":"historian","context":"Conservation, dams and relocation as histories of the Canadian state and of 'the scales of justice' at which environmental change is apprehended (2006–19); asked the field in 2014 to connect with the world. Books known by publisher description; the 2007 abstract read.","works":"States of Nature (2006); 'Disturbing the Peace' (2007); 'Missed Connections' (2014); Moved by the State (2019)","source_ids":["p4c_loo_states_2006","p4c_loo_disturbing_2007","pe131_extras_loo_2014","p4c_loo_moved_2019"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"liza_piper","role":"historian","context":"Industry in the subarctic lakes, 1921–60, 'a seam in the Canadian interior where industrial economies took root'; with Sandlos, ecological imperialism as 'a broken frontier' in the North, where 'the broad ecological transformation' of the south never came. Description and abstract read; bodies unread.","works":"The Industrial Transformation of Subarctic Canada (2009); with John Sandlos, 'A Broken Frontier' (2007)","source_ids":["p4c_piper_industrial_2009","p4c_piper_sandlos_2007"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"alan_maceachern","role":"historian","context":"Atlantic Canada's national parks (2001); NiCHE's director in its SSHRC-cluster years; co-editor of the 2007 Canadian number of Environmental History and of Method and Meaning (2009). Book unread; publisher page unreachable.","works":"Natural Selections (2001); Environmental History 12:4 (2007, ed. with Evenden); Method and Meaning in Canadian Environmental History (2009, ed. with Turkel)","source_ids":["p4c_maceachern_natural_2001","p4c_eh_canada_issue_2007","p4c_niche_about"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"graeme_wynn","role":"historian","context":"Geographer and general editor of UBC Press's Nature | History | Society series ('the interface between nature and society'); wrote the 2007 synthesis Canada and Arctic North America (unread) and in 2003 called the field 'undeveloped in this country, compared with the United States'.","works":"Canada and Arctic North America (2007); series forewords (2006–)","source_ids":["p4c_ubc_nhs_series","p4c_wynn_canada_2007","pe131_extras_wynn_2003","pe131_extras_wynn_2004"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"john_sandlos","role":"historian","context":"Game laws, parks and sanctuaries in the Northwest Territories 'helped the state assert authority over traditional hunting cultures' (2007; CHA Clio and FHS Weyerhaeuser awards); Jacoby called it 'a powerful new interpretation'. Description read; body unread.","works":"Hunters at the Margin (2007); with Liza Piper, 'A Broken Frontier' (2007)","source_ids":["p4c_sandlos_hunters_2007","p4c_piper_sandlos_2007"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"matthew_evenden","role":"historian","context":"The Fraser as 'a river basin where development decisions did not ultimately dam the river, but rather conserved its salmon' (2004); urban rivers compared across Europe and North America (2012); co-editor of the 2007 Canadian number. Descriptions read; bodies unread.","works":"Fish versus Power (2004); Urban Rivers (2012, ed. with Castonguay)","source_ids":["p4c_evenden_fish_2004","p4c_castonguay_evenden_urban_2012","p4c_eh_canada_issue_2007"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"george_colpitts","role":"historian","context":"The pemmican trade as a food market that 'nearly wiped out the Canadian bison herds north of the Missouri River' (2014). Publisher description only.","works":"Pemmican Empire (2014)","source_ids":["p4c_colpitts_pemmican_2014"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"joy_parr","role":"historian","context":"Embodied, sensory histories of megaprojects and environmental change in Canada, 1953–2003 (edge_963); the row places her in the Canadian field's cohort of the 2000s.","works":"Sensing Changes (2010); 'Smells Like?' (2006)","source_ids":["pe135_parr_sensing_2010","pe135_parr_envhist_2006"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"j_r_mcneill","role":"historian","context":"World environmental history of the twentieth century (2000; WHA and Weyerhaeuser prizes), a survey of the field's 'nature and culture' (2003), the Anthropocene since 1945 (2016); ASEH president; told the AHA in 2020 that the field 'stands to be disrupted, and with luck enhanced, more than most'. The 2000 and 2016 books unread.","works":"Something New Under the Sun (2000); 'Observations on the Nature and Culture of Environmental History' (2003); with Engelke, The Great Acceleration (2016)","source_ids":["p4c_mcneill_something_new_2000","pe131_extras_mcneill_2003","p4c_mcneill_great_acceleration_2016","p4c_mcneill_wilson_bio","p4c_mcneill_aha_2020"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"paul_sutter","role":"historian","context":"Surveyed the field for the JAH in 2013: environmental historians had 'replaced the once-firm categories of nature and culture with various approaches to environmental hybridity', a turn 'analytically essential' yet leaving the field 'at a moral crossroads' (the editors' summary; the essay is unread); succeeded Cronon as Weyerhaeuser series editor (2014).","works":"'The World with Us: The State of American Environmental History' (2013); Driven Wild (2002)","source_ids":["p4c_sutter_world_2013","p4c_jah_forum_2013","p4c_cronon_cv"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"karl_jacoby","role":"historian","context":"Cronon's student at Yale; the 'hidden history' of conservation as squatters, poachers and thieves (2001; Marsh and Littleton-Griswold prizes). Book unread; known through the CV and Crossref.","works":"Crimes against Nature (2001)","source_ids":["p4c_jacoby_crimes_2001","p4c_cronon_cv"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"mark_david_spence","role":"historian","context":"Indian removal from Yellowstone, Glacier and Yosemite as the making of 'uninhabited wilderness' (1999). Abstract read; body unread.","works":"Dispossessing the Wilderness (1999)","source_ids":["p4c_spence_dispossessing_1999"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"dave_foreman","role":"critic","context":"Wilderness activist who answered the academic critics: the 'Received Wilderness Idea' of 'Baird Callicott, Bill Cronon and other postmodern deconstructionist scholars' is 'a straw dog; it does not exist on the ground' (1999/2000; read in full), against 'the Real Wilderness Idea' that built the National Wilderness Preservation System.","works":"'Wilderness Areas for Real' (1998); 'The Real Wilderness Idea' (2000)","source_ids":["p4c_foreman_real_2000","p4c_callicott_nelson_1998"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"j_baird_callicott","role":"critic","context":"Environmental philosopher; co-edited The Great New Wilderness Debate (1998), where the positions on 'preservation' and 'wise use' were gathered; named by Foreman with Cronon as a 'deconstructionist'. Publisher description and Foreman's citation only.","works":"The Great New Wilderness Debate (ed. with Michael P. Nelson, 1998)","source_ids":["p4c_callicott_nelson_1998","p4c_foreman_real_2000"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"linda_nash","role":"contributor","context":"Asked whether nature has agency or agency has a nature in the 2005 anniversary forum and urged 'Furthering the Environmental Turn' in the 2013 forum; disease as environmental history (2006, 2014). Metadata only.","works":"'The Agency of Nature or the Nature of Agency?' (2005); Inescapable Ecologies (2006); 'Furthering the Environmental Turn' (2013)","source_ids":["p4c_eh_whats_next_2005","p4c_jah_forum_2013","p4c_isenberg_handbook_2014"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"andrew_isenberg","role":"contributor","context":"Edited the Oxford Handbook (2014), whose abstract holds the field 'widely recognized within the mainstream of academic history' since the early 1980s and whose introduction 'focuses on the integration of the insights of environmental history with a host of other subfields'; his 2013 survey is read.","works":"The Oxford Handbook of Environmental History (ed., 2014); 'From the Periphery to the Center' (2013)","source_ids":["p4c_isenberg_handbook_2014","pe131_crosby_isenberg_2013"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"andreas_malm","role":"contributor","context":"Fossil Capital (2016): 'steam offered neither cheaper nor more abundant energy' but control over labour; read on its cover as an answer to the 'Anthropocene narrative'. Publisher page only.","works":"Fossil Capital (2016)","source_ids":["p4c_malm_fossil_2016"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"christophe_bonneuil","role":"contributor","context":"With Fressoz, 'the first critical history of the Anthropocene', refusing 'the convenient view of a \"human species\" that upset the Earth system' (2013; English 2016). Publisher description only.","works":"The Shock of the Anthropocene (2016, with Jean-Baptiste Fressoz)","source_ids":["p4c_bonneuil_fressoz_2016"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"jean_baptiste_fressoz","role":"contributor","context":"With Bonneuil, 'the first critical history of the Anthropocene' (2013; English 2016). Publisher description only.","works":"The Shock of the Anthropocene (2016, with Christophe Bonneuil)","source_ids":["p4c_bonneuil_fressoz_2016"],"basis":"source_review"}},{"node":"environment","proposal_id":null,"row":{"person_id":"james_daschuk","role":"contributor","context":"Disease, climate and 'Canadian politics' in the loss of Indigenous life on the Plains (2013; GG History Award, Macdonald and Clio prizes); blurbed by McNeill; in Canadian PhD bibliographies read beside the environmental founders from 2015 and with Wolfe after 2020 (History PhD citation graph, release 2026-10-23). The settler-colonial reading is on settler_colonialism.","works":"Clearing the Plains (2013)","source_ids":["p4c_daschuk_clearing_2013"],"basis":"source_review"}},{"node":"global","proposal_id":null,"row":{"person_id":"j_r_mcneill","role":"contributor","context":"A world environmental history of the twentieth century (2000) and, with Engelke, of the Anthropocene since 1945 (2016): 'human dependence on fossil fuels inaugurated the Anthropocene'. Books unread.","works":"Something New Under the Sun (2000); The Great Acceleration (2016)","source_ids":["p4c_mcneill_something_new_2000","p4c_mcneill_great_acceleration_2016"],"basis":"source_review"}},{"node":"indigenous","proposal_id":null,"row":{"person_id":"mark_david_spence","role":"contributor","context":"Indian removal from Yellowstone, Glacier and Yosemite as the making of 'uninhabited wilderness' (1999): 'the early conception of the wilderness as the place where Indians lived (or should live)' gave way to its idealisation as empty. Abstract read.","works":"Dispossessing the Wilderness (1999)","source_ids":["p4c_spence_dispossessing_1999"],"basis":"source_review"}},{"node":"indigenous","proposal_id":null,"row":{"person_id":"karl_jacoby","role":"contributor","context":"Conservation's 'hidden history' of squatters, poachers and thieves (2001); endorsed Sandlos's Canadian parallel. Book unread.","works":"Crimes against Nature (2001)","source_ids":["p4c_jacoby_crimes_2001","p4c_sandlos_hunters_2007"],"basis":"source_review"}},{"node":"indigenous","proposal_id":null,"row":{"person_id":"john_sandlos","role":"contributor","context":"Northern game laws, parks and sanctuaries as the state's authority over Dene and Inuit hunting cultures (2007). Description read.","works":"Hunters at the Margin (2007)","source_ids":["p4c_sandlos_hunters_2007"],"basis":"source_review"}}]
