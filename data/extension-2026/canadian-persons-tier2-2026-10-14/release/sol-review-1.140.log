/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import json,re,unicodedata,subprocess
root=Path('/tmp/claude-1000/-home-jic823-historiography/349191d8-7a3f-4dc4-b66b-19d6c4dee53d/scratchpad')
paths=[]
for folder in ['kealey-raw','ct2dl','vkb_dl','hp139','olson-dl','ouel-pdf']:
 paths.extend((root/folder).rglob('*.txt'))
# publisher 2014 PDFs have no text files for frontmatter/ch1
for p in [root/'olson-dl/hgis_Frontmatter.pdf',root/'olson-dl/hgis_Chapter01.pdf']:
 if p.exists():
  paths.append(p)
def norm(s):
 s=unicodedata.normalize('NFKD',s.lower());s=re.sub(r'(?<=\\w)[-‐]\\s*\\n\\s*(?=\\w)','',s)
 return re.sub(r'["'^a-z0-9]'"','',s)
corpus={str(p.relative_to(root)):norm(subprocess.check_output(['pdftotext',str(p),'-']).decode(errors='replace') if p.suffix=='.pdf' else p.read_text(errors='replace')) for p in paths}
d=json.load(open('data/extension-2026/canadian-persons-tier2-2026-10-14/release/editorial-additions.json'))
for e in d['edges']:
 qs=re.findall(r\"(?<"'!'"\\w)'(.+?)'(?"'!'"\\w)\",e['evidence_note'])
 bad=[]
 for q in qs:
  if len(q.split())<5:continue
  pieces=[z for z in re.split(r'…|\\.\\.\\.',q) if len(z.split())>=5]
  if pieces and not all(any(norm(z) in s for s in corpus.values()) for z in pieces):bad.append(q)
 if bad: print(e['proposal_id'],json.dumps(bad,ensure_ascii=False))
