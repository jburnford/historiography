PREFIX marcrel: <http://id.loc.gov/vocabulary/relators/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX bio: <http://purl.org/vocab/bio/0.1/>
SELECT DISTINCT ?authority ?doc ?role ?date ?citation WHERE {
 VALUES ?authority { <http://www.idref.fr/026750759/id> <http://www.idref.fr/026754959/id> <http://www.idref.fr/026755955/id> <http://www.idref.fr/026773546/id> <http://www.idref.fr/026814102/id> <http://www.idref.fr/026834413/id> <http://www.idref.fr/026988720/id> <http://www.idref.fr/027064549/id> } VALUES ?role { marcrel:aut marcrel:edt marcrel:pbd marcrel:trl marcrel:aui }
 ?doc ?role ?authority . FILTER(STRSTARTS(STR(?doc),"http://www.sudoc.fr/") || STRSTARTS(STR(?doc),"https://www.sudoc.fr/"))
 OPTIONAL { ?doc dc:date ?date } OPTIONAL { ?doc dct:bibliographicCitation ?citation }
} ORDER BY ?authority ?doc ?role ?date ?citation LIMIT 9999