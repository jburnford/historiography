PREFIX marcrel: <http://id.loc.gov/vocabulary/relators/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX bio: <http://purl.org/vocab/bio/0.1/>
SELECT DISTINCT ?authority ?doc ?role ?date ?citation WHERE {
 VALUES ?authority { <http://www.idref.fr/070415439/id> <http://www.idref.fr/071086285/id> <http://www.idref.fr/073952044/id> <http://www.idref.fr/076349071/id> <http://www.idref.fr/077762347/id> <http://www.idref.fr/077783123/id> <http://www.idref.fr/085037567/id> <http://www.idref.fr/085716553/id> } VALUES ?role { marcrel:aut marcrel:edt marcrel:pbd marcrel:trl marcrel:aui }
 ?doc ?role ?authority . FILTER(STRSTARTS(STR(?doc),"http://www.sudoc.fr/") || STRSTARTS(STR(?doc),"https://www.sudoc.fr/"))
 OPTIONAL { ?doc dc:date ?date } OPTIONAL { ?doc dct:bibliographicCitation ?citation }
} ORDER BY ?authority ?doc ?role ?date ?citation LIMIT 9999